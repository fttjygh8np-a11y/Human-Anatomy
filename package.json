{
  "name": "anatomi-3b",
  "private": true,
  "version": "0.1.0",
  "description": "Tıp öğrencileri için kaynak temelli, etkileşimli 3B anatomi öğrenme uygulaması",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "npm run content:build",
    "dev": "vite",
    "build": "npm run content:build && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "perf": "node scripts/perf/measure.ts",
    "models:fetch": "node scripts/models/fetch-bodyparts3d.ts",
    "models:build": "node scripts/models/build-models.ts",
    "models:hra": "node scripts/models/hra/build-hra.ts",
    "content:inventory": "node scripts/content/build-inventory.ts",
    "content:terms": "node scripts/content/terminology.ts",
    "content:relations": "node scripts/content/relations.ts",
    "content:iuc": "node scripts/content/iuc.ts",
    "content:iuc-terms": "node scripts/content/iuc-terms.ts",
    "content:iuc-scope": "node scripts/content/iuc-scope.ts",
    "content:build": "node scripts/content/build-content.ts",
    "content:validate": "node scripts/content/validate-content.ts",
    "content:quotecheck": "node scripts/content/quotecheck.ts",
    "report:coverage": "node scripts/reports/coverage-report.ts",
    "report:inventory": "node scripts/reports/inventory-matrix.ts",
    "report:release": "node scripts/reports/release-gates.ts",
    "setup": "npm run models:fetch && npm run models:build && npm run models:hra && npm run content:iuc && npm run content:build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "idb": "8.0.3",
    "minisearch": "7.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.15",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "fflate": "0.8.3",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "meshoptimizer": "1.2.0",
    "pdfjs-dist": "6.3.289",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
